# Vexor Backend Environment Variables
# Copy this to .env and fill in your keys

# ─── Security ────────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-this

# ─── AI Providers (All Free) ─────────────────────────────────
GROQ_API_KEY=your-groq-api-key
NVIDIA_API_KEY=your-nvidia-nim-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
HUGGINGFACE_API_KEY=your-huggingface-api-key

# ─── OSINT API Keys (All Free Tier) ──────────────────────────
# Shodan — https://account.shodan.io  (free: 100 queries/month)
SHODAN_API_KEY=your-shodan-api-key

# VirusTotal — https://www.virustotal.com/gui/my-apikey  (free: 500/day)
VIRUSTOTAL_API_KEY=your-virustotal-api-key

# AlienVault OTX — https://otx.alienvault.com/api  (free: unlimited)
OTX_API_KEY=your-otx-api-key

# URLScan.io — https://urlscan.io/user/profile  (free: 5000/day)
URLSCAN_API_KEY=your-urlscan-api-key

# ProjectDiscovery Chaos — https://chaos.projectdiscovery.io  (free: 1000/day)
CHAOS_API_KEY=your-chaos-api-key
